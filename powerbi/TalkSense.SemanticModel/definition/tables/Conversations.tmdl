table Conversations
	lineageTag: 00000000-0000-0000-0000-000000000001

	measure 'Total Conversas' = COUNTROWS(Conversations)
		formatString: #,##0
		displayFolder: 01 Retencao IA
		lineageTag: 00000000-0000-0000-0000-000000000014

	measure 'Conversas Resolvidas IA' = CALCULATE(COUNTROWS(Conversations), Conversations[outcome] = "resolved_by_ai")
		formatString: #,##0
		displayFolder: 01 Retencao IA
		lineageTag: 00000000-0000-0000-0000-000000000015

	measure 'Retencao IA (%)' = DIVIDE([Conversas Resolvidas IA], [Total Conversas])
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: 01 Retencao IA
		lineageTag: 00000000-0000-0000-0000-000000000016

